config ENTROPY_NXP_S32_HSE_TRNG
	bool "NXP S32 HSE TRNG driver"
	default y
	depends on DT_HAS_NXP_S32_HSE_ENTROPY_ENABLED
	select ENTROPY_HAS_DRIVER
	help
	  Enable the NXP S32 HSE true random number generator (TRNG) driver. Sources entropy via
	  the HSE firmware's Get Random Number service (HSE_SRV_ID_GET_RANDOM_NUM), over a Messaging
	  Unit instance separate from the one used by CRYPTO_NXP_S32_HSE.
