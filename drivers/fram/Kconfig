menuconfig FRAM
	bool "FRAM hardware support"
	help
	  Enable support for FRAM hardware.

if FRAM

module = FRAM
module-str = fram
source "subsys/logging/Kconfig.template.log_config"

config FRAM_INIT_PRIORITY
	int "FRAM init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  FRAM driver device initialization priority.

config FRAM_SHELL
	bool "FRAM shell"
	default n
	depends on SHELL
	help
	  Enable the FRAM shell with FRAM related commands.

config FRAM_SHELL_BUFFER_SIZE
	int "FRAM shell buffer size"
	default 256
	depends on FRAM_SHELL
	help
	  Size of the buffer used for FRAM read/write commands in
	  the FRAM shell.

# CUSTOM@NDRS: selected by FRAM_CY15XJ / FRAM_CY15XQ only. A default y here compiled the driver on a core whose
# devicetree has no FRAM (the bcu-mv25 M55), which left fram_cy15x_init() unused.
config FRAM_CY15X
	bool
	help
	  Enable support for Infineon CY15X (and compatible) I2C/SPI
	  FRAMs.

# CUSTOM@NDRS: a probe for the settings store (ZMS), which saw "Invalid data CRC" at boot on the bcu-mv25.
config FRAM_CY15X_VERIFY
	bool "Verify every FRAM read and write"
	depends on FRAM_CY15X
	help
	  Read every block twice and compare the two reads, and read every written block back. A block that
	  differs is logged with the offset, the number of bytes that differ and the first and last one, and is
	  read or written again. Tells a block that was read wrong from one that was written wrong. Doubles the
	  read time of the store.

config FRAM_CY15XJ
	bool "Infineon CY15J (and compatible) I2C FRAM support"
	default y
	depends on DT_HAS_INFINEON_CY15XJ_ENABLED
	select I2C
	select FRAM_CY15X
	help
	  Enable support for Infineon CY15J (and compatible) I2C FRAMs.

config FRAM_CY15XQ
	bool "Infineon CY15Q (and compatible) SPI FRAM support"
	default y
	depends on DT_HAS_INFINEON_CY15XQ_ENABLED
	select SPI
	select FRAM_CY15X
	help
	  Enable support for Infineon CY15Q (and compatible) SPI FRAMs.

endif # FRAM
